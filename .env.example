# Copy this file to .env and fill in real values. .env is gitignored.
# See pyproject.toml for which keys are required vs optional.

# ═══════════════════════════════════════════════════════════════
#  Default: LOCAL Ollama backend — $0, no API keys, fully private
# ═══════════════════════════════════════════════════════════════

ITERATE_BACKEND_URL=http://localhost:11434/v1
ITERATE_BACKEND_API_KEY=ollama
ITERATE_MODEL=qwen3:14b
ITERATE_BACKEND_TIMEOUT=120

# Run `ollama pull qwen3:14b` then `ollama serve` to start.
# (qwen3 emits structured tool calls — required for the agentic loop; the
#  qwen2.5-coder variant does not. qwen3 also has a thinking mode on by default.)
# Any OpenAI-compatible endpoint works here — just change the URL + model.

# ─── Required: sandbox for code execution ────────────────────
E2B_API_KEY=

# ─── Required: dataset access ────────────────────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=

# ═══════════════════════════════════════════════════════════════
#  Optional: cloud LLM backends (switch ITERATE_BACKEND_URL to use)
# ═══════════════════════════════════════════════════════════════
# ITERATE_BACKEND_* is the HARNESS, the model that runs the loop.
# The model under test of a prompt run runs on Ollama unless --target-backend
# names another provider, and never reads ITERATE_BACKEND_API_KEY or
# ITERATE_BACKEND_URL. It reads its provider's own key below (GROQ_API_KEY
# for groq), or a key saved with `iterate setup`.
# One key for one run, whoever the provider: export ITERATE_TARGET_API_KEY
# in your shell. It is not read from this file.

# Groq: free tier, fast open models
# ITERATE_BACKEND_URL=https://api.groq.com/openai/v1
# ITERATE_BACKEND_API_KEY=<your-groq-key>
# ITERATE_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Together AI — paid, very cheap Llama 3.3 70B
# ITERATE_BACKEND_URL=https://api.together.xyz/v1
# ITERATE_BACKEND_API_KEY=<your-together-key>
# ITERATE_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_API_KEY=

# Deepseek — paid, strong on code
# ITERATE_BACKEND_URL=https://api.deepseek.com/v1
# ITERATE_BACKEND_API_KEY=<your-deepseek-key>
# ITERATE_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# OpenAI — for GPT-4/5
OPENAI_API_KEY=

# Anthropic: Claude as the model under test of a prompt run, not a harness backend
# (--target-backend anthropic; pip install 'iterate-ai[anthropic]')
ANTHROPIC_API_KEY=

# ─── Optional: logging adapters ──────────────────────────────
NOTION_API_KEY=
NOTION_DATABASE_ID=
SLACK_WEBHOOK_URL=

# ─── Optional: tracing ───────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ─── Local config ────────────────────────────────────────────
ITERATE_MEMORY_DB=.iterate/memory.db
ITERATE_RUNS_DIR=.iterate/runs
